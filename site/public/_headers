/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), bluetooth=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://jobs-api.ajeenckya.workers.dev https://boards-api.greenhouse.io https://api.lever.co https://api.ashbyhq.com https://remotive.com https://www.arbeitnow.com https://generativelanguage.googleapis.com https://api.groq.com https://api.openai.com https://api.anthropic.com https://openrouter.ai https://*.ingest.sentry.io; base-uri 'self'; form-action 'self'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/feeds/*
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
