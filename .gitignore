# Personal config with credentials — use config.example.yaml as template
# The glob covers every per-track config (config_ml, config_ops, config_ai,
# config_ie, ...); config.example.yaml is dot-separated and stays tracked.
config.yaml
config_*.yaml
*.yaml.bak*
*.bak
*.bak-*

# Runtime state and personal ledgers
autopilot.sqlite
*.sqlite
*.sqlite-journal
ml/
ops/
data/
*.xlsx
digest.json
chunk_stats.json

# Logs and output
logs/
*.log

# Resumes (personal documents). resume_*.pdf also covers the copies that
# ci/build_config.py decodes from the RESUME_*_B64 secrets at runtime.
resumes/
resume_ml.txt
resume_ops.txt
resume_*.pdf
*.pdf

# CI scratch output (workbooks, sqlite, browser profile)
out/

# Local launchd / install leftovers
.initialized
.sched_cursor.json
com.aj.jobsearch.plist

# Browser profile (may contain session cookies)
browser-profile/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Worker dependencies
worker/node_modules/

worker/.wrangler/
